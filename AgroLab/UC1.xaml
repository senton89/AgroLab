<UserControl x:Class="AgroLab.UC1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AgroLab"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/> <!-- Sidebar -->
            <ColumnDefinition Width="3*"/> <!-- Main Content -->
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#4A5568" Margin="16"> <!-- bg-gray-700 -->
            <TextBlock Text="Редактирование нормативного документа" 
                       FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
            <ListBox Background="#4A5568" Foreground="White">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <TextBlock Text="📁" Margin="0,0,8,0"/> <!-- Font Awesome icon -->
                        <TextBlock Text="Общие"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Background="#4A5568">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <TextBlock Text="📁" Margin="0,0,8,0"/>
                        <TextBlock Text="Содержание"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <TextBlock Text="📁" Margin="0,0,8,0"/>
                        <TextBlock Text="Положения нормативного документа"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <TextBlock Text="📁" Margin="0,0,8,0"/>
                        <TextBlock Text="Структура"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>
        <!-- Main Content -->
        <StackPanel Grid.Column="1" Background="#EDF2F7" Margin="16"> <!-- bg-gray-200 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <TextBlock Text="Содержание" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="➕" 
                        Background="Transparent" 
                        BorderBrush="Transparent" 
                        Foreground="#A0AEC0" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <!-- Left Panel -->
                <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,16,0" 
                        BorderBrush="#E2E8F0" BorderThickness="1" Width="*">
                    <!-- Content goes here -->
                </Border>
                <!-- Right Panel -->
                <StackPanel Width="250" Margin="0,0,0,0">
                    <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,16" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <!-- <TextBlock Text="Наименование" FontWeight="SemiBold" Margin="0,0,0,8"/> -->
                        <TextBox Text="Наименование" Margin="0,0,0,0" />
                    </Border>
                    <Border Background="White" Padding="16" CornerRadius="8" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <!-- <TextBlock Text="Вложение" FontWeight="SemiBold" Margin="0,0,0,8"/> -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Выберите файл" 
                                    Background="#E2E8F0" 
                                    BorderBrush="#CBD5E0" 
                                    Margin="0,0,8,0"/>
                            <Button Content="📁" Background="Transparent" BorderBrush="Transparent"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment ="Right" Margin="0,16,0,0">
                <Button Content="Отменить" 
                        Background="#4A5568" 
                        Foreground="White" 
                        Margin="0,0,8,0" 
                        Width="80" Height="30"/>
                <Button Content="Сохранить" 
                        Background="#3498DB" 
                        Foreground="White" 
                        Width="80" Height="30"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
